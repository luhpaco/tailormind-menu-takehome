---
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Menú | TailorMind Take-Home</title>
	</head>
	<body>
		<div class="page">
			<header class="page-header">
				<h1>Nuestro menú</h1>
				<p>Arma tu pedido y envíalo directamente desde acá.</p>
			</header>

			<div class="layout">
				<main id="menu-root" aria-live="polite">
					<p class="state-message">Cargando menú…</p>
				</main>

				<aside class="cart-panel" aria-label="Carrito de compras">
					<h2>Tu carrito</h2>
					<div id="cart-items" class="cart-items">
						<p class="state-message">Tu carrito está vacío.</p>
					</div>
					<div class="cart-total">
						<span>Total</span>
						<span id="cart-total">S/ 0.00</span>
					</div>
				</aside>
			</div>
		</div>

		<script>
			import '../scripts/menu.ts';
			import '../scripts/cart.ts';
		</script>
	</body>
</html>
